# ==================== 数据库配置 ====================
# PostgreSQL 数据库连接串（必填）
# 格式: postgresql://用户名:密码@主机:端口/数据库名
# ⚠️ 生产环境务必添加 ?sslmode=require
# 示例: postgresql://postgres:password@host:5432/db?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/dunhuang_design

# Supabase 数据库连接串（可选，已废弃，仅向后兼容）
# 推荐直接使用 DATABASE_URL 替代本变量
# SUPABASE_DATABASE_URL=postgresql://postgres:xxx@db.xxx.supabase.co:5432/postgres

# ==================== 认证配置 ====================
# JWT 密钥（必填，建议使用随机字符串，至少32位）
# ⚠️ 生产环境禁止使用以下占位符值，否则服务将拒绝启动
# 请使用: openssl rand -base64 32 生成随机密钥
JWT_SECRET=YOUR_JWT_SECRET_HERE

# ==================== AI 服务配置 ====================
# ⚠️ 以下 key 与 docker-compose.yml environment 严格一一对应（任务3 对齐）
# 生产部署时从 docker-compose 的 environment 注入，禁止写入镜像/Dockerfile

# MiniMax（图片生成主力，compose 已引用）
MINIMAX_API_KEY=your-minimax-api-key
MINIMAX_API_BASE=https://api.minimax.chat/v1
MINIMAX_MODEL=

# 通义千问 Qwen（对话/LLM，compose 已引用）
QWEN_API_KEY=your-qwen-api-key

# 智谱AI（支持图片生成和对话）
ZHIPU_API_KEY=your-zhipu-api-key

# Kimi / Moonshot（对话，可选）
KIMI_API_KEY=your-kimi-api-key

# Meshy（3D 生成，浮雕/图转3D 用）
MESHY_API_KEY=your-meshy-api-key

# OpenAI（可选）
OPENAI_API_KEY=your-openai-api-key

# 通用 LLM / 图片 / 视频 key（api-config-service 兜底通道）
LLM_API_KEY=
IMAGE_API_KEY=
VIDEO_API_KEY=

# 豆包/火山引擎（可选）
DOUBAO_API_KEY=your-doubao-api-key

# Stability AI（可选，专业图片生成）
STABILITY_API_KEY=your-stability-api-key

# Midjourney API（可选）
MIDJOURNEY_API_KEY=your-midjourney-api-key

# ==================== 密钥加密 ====================
# API Key 加密密钥（AES-256-GCM，64 位 hex，必填）
# 生成: openssl rand -hex 32
API_KEY_ENCRYPTION_KEY=

# ==================== 对象存储配置 ====================
# S3 兼容对象存储（用于文件上传）
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_BUCKET=your-bucket-name
S3_REGION=auto
S3_ENDPOINT=https://xxx.r2.cloudflarestorage.com

# ==================== 缓存配置（可选） ====================
# Redis 连接地址
REDIS_URL=redis://localhost:6379

# ==================== 应用配置 ====================
# 应用域名（生产环境必填）
NEXT_PUBLIC_APP_URL=http://localhost:5000

# 服务端口（compose 注入）
PORT=5000

# CORS 允许来源（compose 注入）
ALLOWED_ORIGIN=http://localhost:5000

# 存储：local / s3（compose 注入）
STORAGE_PROVIDER=local
UPLOAD_DIR=/app/uploads

# 环境
NODE_ENV=development

# ==================== 本地AI服务配置（可选） ====================
# ComfyUI
COMFYUI_HOST=127.0.0.1
COMFYUI_PORT=8188

# Ollama
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434

# Stable Diffusion WebUI
WEBUI_HOST=127.0.0.1
WEBUI_PORT=7860

# ==================== 监控配置（可选） ====================
# Sentry 错误监控（可选，生产环境推荐启用）
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_AUTH_TOKEN=your-sentry-auth-token

# ==================== 速率限制配置（可选） ====================
# API 全局速率限制（请求数/时间窗口）
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS=60
# 启用按路径区分限制（不同API独立计数）
# RATE_LIMIT_PER_PATH=false
