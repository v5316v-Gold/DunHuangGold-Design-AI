# 敦煌金 AI 平台 - Worker 专用 Dockerfile（Phase 9.15 优化）
# 用 alpine + 自装 Node（避免拉 node:20-alpine 慢）
#
# 构建：
#   docker build -f Dockerfile.worker -t dunhuang-ai-worker:latest .
#
# 运行：
#   docker run --rm \
#     -e REDIS_URL=redis://host:6379 \
#     -e DATABASE_URL=postgresql://user:***@host:5432/db \
#     -e JWT_SECRET=<32+ chars> \
#     -e API_KEY_ENCRYPTION_KEY=<32 bytes hex> \
#     dunhuang-ai-worker:latest

# 阶段1: 依赖
FROM alpine:3.20 AS deps
WORKDIR /app
# 国内镜像源加速
RUN sed -i 's|dl-cdn.alpinelinux.org|mirrors.tuna.tsinghua.edu.cn|g' /etc/apk/repositories && \
    apk add --no-cache nodejs npm bash && \
    npm install -g pnpm@9 --registry=https://registry.npmmirror.com
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --registry=https://registry.npmmirror.com

# 阶段2: 构建 worker 产物
FROM alpine:3.20 AS builder
WORKDIR /app
RUN sed -i 's|dl-cdn.alpinelinux.org|mirrors.tuna.tsinghua.edu.cn|g' /etc/apk/repositories && \
    apk add --no-cache nodejs npm bash && \
    npm install -g pnpm@9 --registry=https://registry.npmmirror.com
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# 打包 worker（解析 @/ 别名，输出自包含 CJS）
RUN ./node_modules/.bin/tsup workers/orchestrator-worker.ts \
  --format cjs \
  --platform node \
  --target node20 \
  --out-dir dist-workers \
  --clean \
  --external pg \
  --external bcryptjs \
  --external ioredis

# 阶段3: 运行（最小镜像）
FROM alpine:3.20 AS runner
WORKDIR /app
RUN sed -i 's|dl-cdn.alpinelinux.org|mirrors.tuna.tsinghua.edu.cn|g' /etc/apk/repositories && \
    apk add --no-cache nodejs npm bash

ENV NODE_ENV=production

# 复制 worker 产物
COPY --from=builder /app/dist-workers ./dist-workers
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./

# P0-1: 迁移文件 + entrypoint（worker 启动前自动迁移）
COPY --from=builder /app/scripts/migrate.js ./scripts/migrate.js
COPY --from=builder /app/src/db/migrations ./src/db/migrations
COPY --from=builder /app/src/storage/database/migrations ./src/storage/database/migrations
COPY --from=builder /app/scripts/docker-entrypoint.sh ./scripts/docker-entrypoint.sh
RUN chmod +x /app/scripts/docker-entrypoint.sh

# 非 root 用户
RUN addgroup -S nodejs -g 1001 && adduser -S worker -u 1001
USER worker

# 启动前自动迁移（ENTRYPOINT_MIGRATE=0 可跳过）
ENTRYPOINT ["/app/scripts/docker-entrypoint.sh"]
CMD ["node", "dist-workers/orchestrator-worker.js"]